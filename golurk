# ── Default ignores ───────────────────────────────────────────────────
DIR_IGNORES=( "node_modules" ".next" ".git" "__pycache__" ".idea" ".vscode" "target" "build" "dist" "out" ".gradle" )
FILE_IGNORES=()
GITIGNORE_NEGATIONS=()   # patterns that un-exclude (e.g., !important.log)

# ── Shared computed state (built once, reused) ────────────────────────
PRUNE_ARGS=()
GREP_REGEX=""
TREE_PATTERN=""

# ──────────────────────────────────────────────────────────────────────
# Color setup — auto-detected; re-called after --no-color
# ──────────────────────────────────────────────────────────────────────
setup_colors() {
  if [[ "$NO_COLOR" = true ]] || [[ ! -t 1 ]]; then
    C_DIR="" C_FILE="" C_RESET="" C_DIM="" C_BOLD="" C_GREEN="" C_YELLOW="" C_RED="" C_CYAN=""
  else
    C_DIR="\033[1;34m"    # bold blue  — directories
    C_FILE="\033[0m"      # default    — files
    C_RESET="\033[0m"
    C_DIM="\033[2m"
    C_BOLD="\033[1m"
    C_GREEN="\033[0;32m"
    C_YELLOW="\033[0;33m"
    C_RED="\033[0;31m"
    C_CYAN="\033[0;36m"
  fi
}
setup_colors

# ──────────────────────────────────────────────────────────────────────
# Update Checker (Non-blocking)
# ──────────────────────────────────────────────────────────────────────
check_for_updates() {
  local cache_file="${HOME}/.golurk_latest_version"
  
  # 1. Print banner if we already know an update exists
  if [[ -f "$cache_file" ]]; then
    local latest; latest=$(cat "$cache_file" 2>/dev/null || true)
    if [[ -n "$latest" && "$latest" != "$VERSION" ]]; then
      printf "\n${C_YELLOW}⭐ A new version of golurk is available! (${C_BOLD}%s${C_RESET}${C_YELLOW}) - Run 'npm i -g golurk@latest' or 'brew upgrade golurk' to update.${C_RESET}\n\n" "$latest" >&2
    elif [[ "$latest" == "$VERSION" ]]; then
      rm -f "$cache_file" 2>/dev/null || true
    fi
  fi

  # 2. Check for new updates in the background (only once a day to prevent spam)
  local last_check_file="${HOME}/.golurk_last_check"
  local current_time; current_time=$(date +%s 2>/dev/null || echo 0)
  local last_check; last_check=$(cat "$last_check_file" 2>/dev/null || echo 0)
  
  if (( current_time - last_check > 86400 )); then
    echo "$current_time" > "$last_check_file" 2>/dev/null || true
    (
      local latest_npm; latest_npm=$(curl -s --max-time 3 https://registry.npmjs.org/golurk/latest 2>/dev/null | grep -o '"version":"[^"]*"' | cut -d'"' -f4)
      if [[ -n "$latest_npm" && "$latest_npm" != "$VERSION" ]]; then
        echo "$latest_npm" > "$cache_file" 2>/dev/null || true
      fi
    ) &>/dev/null &
  fi
}

# Run the update check (except in watch mode or pure JSON/YAML output modes)
if [[ "${ORIGINAL_ARGS[*]:-}" != *"--json"* && "${ORIGINAL_ARGS[*]:-}" != *"--yaml"* && "${ORIGINAL_ARGS[*]:-}" != *"--watch"* && "${ORIGINAL_ARGS[*]:-}" != *"--version"* ]]; then
  check_for_updates
fi

# ──────────────────────────────────────────────────────────────────────
# .golurkrc — project-level config loader
# Loaded at startup; CLI args applied afterwards and always win.
# Only safe VAR=value / VAR+=value assignments are allowed.
# ──────────────────────────────────────────────────────────────────────
load_golurkrc() {
  local rc_file="$PROJECT_ROOT/.golurkrc"
  [[ -f "$rc_file" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    local stripped="${line%%#*}"
    stripped="$(printf '%s' "$stripped" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    [[ -z "$stripped" ]] && continue
    # Allow only simple assignments; block command substitutions
    if [[ "$stripped" =~ ^[A-Z_][A-Z0-9_]*(=|\+=) ]] \
       && [[ "$stripped" != *'$('* ]] \
       && [[ "$stripped" != *'`'* ]]; then
      
      local key="${stripped%%=*}"
      local value
      local is_append=false
      
      if [[ "$key" == *+ ]]; then
         key="${key%+}"
         value="${stripped#*+=}"
         is_append=true
      else
         value="${stripped#*=}"
      fi
      
      # Strip leading/trailing quotes
      value="${value%\"}"; value="${value#\"}"
      value="${value%\'}"; value="${value#\'}"
      
      if [[ "$is_append" == true ]]; then
         declare -g "$key=${!key:-}$value"
      else
         declare -g "$key=$value"
      fi
    else
      printf "Warning: .golurkrc line ignored (unsafe/unrecognized): %s\n" "$stripped" >&2
    fi
  done < "$rc_file"
}

# ──────────────────────────────────────────────────────────────────────
# Desktop detection  [FIX v5: WSL usernames with spaces]
# ──────────────────────────────────────────────────────────────────────
detect_desktop() {
  if [[ -n "${XDG_DESKTOP_DIR:-}" ]]; then echo "$XDG_DESKTOP_DIR"; return; fi
  if [[ -d "$HOME/Desktop" ]]; then echo "$HOME/Desktop" && return; fi
  if [[ -d "$HOME/desktop" ]]; then echo "$HOME/desktop" && return; fi
  # WSL: use while+read to correctly handle usernames that contain spaces
  if grep -qEi "(Microsoft|WSL)" /proc/version 2>/dev/null || [[ -n "${WSL_DISTRO_NAME:-}" ]]; then
    # Fast fallback using whoami directly
    local wsl_user; wsl_user=$(whoami 2>/dev/null)
    if [[ -n "$wsl_user" && -d "/mnt/c/Users/$wsl_user/Desktop" ]]; then
      echo "/mnt/c/Users/$wsl_user/Desktop"; return
    fi
    
    local win_user=""
    if command -v cmd.exe &>/dev/null; then
      win_user="$(cmd.exe /c echo %USERNAME% 2>/dev/null | tr -d '\r')"
    fi
    if [[ -n "$win_user" && -d "/mnt/c/Users/$win_user/Desktop" ]]; then
      echo "/mnt/c/Users/$win_user/Desktop"; return
    fi
    # fallback
    while IFS= read -r u; do
      [[ -z "$u" ]] && continue
      if [[ -d "/mnt/c/Users/$u/Desktop" ]]; then
        echo "/mnt/c/Users/$u/Desktop"; return
      fi
    done < <(ls -1 /mnt/c/Users 2>/dev/null || true)
  fi
  echo "$HOME"
}
DESKTOP_PATH="$(detect_desktop)"

to_windows_path() {
  if command -v wslpath &>/dev/null; then
    wslpath -w "$1" 2>/dev/null || echo "$1"
  else
    echo "$1"
  fi
}

# Show a saved path; in WSL also appends the Windows equivalent.
print_saved_path() {
  local path="$1"
  local wpath; wpath="$(to_windows_path "$path")"
  if [[ "$wpath" != "$path" ]]; then
    printf "%s  (Windows: %s)" "$path" "$wpath"
  else
    printf "%s" "$path"
  fi
}

# ──────────────────────────────────────────────────────────────────────
# Banner & usage
# ──────────────────────────────────────────────────────────────────────
