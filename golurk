SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
VERSION="1.1.0"

# ── Output / selection ────────────────────────────────────────────────
OUTPUT_FILE=""
EXTRA_EXCLUDES=()
SHOW_FILES=true
SELECT_PATHS=()
DUMP_CONTENTS=false
CONTENTS_FILE=""
SKIP_BINARIES=false
MAX_SIZE=""
DIR_PATTERN=""
MAX_DEPTH=""
EXACT_LEVEL=""
SHOW_LEVEL=""
OUTPUT_TO_DESKTOP=false
CONTENTS_TO_DESKTOP=false
MICROSERVICE_PATTERN=""
SHOW_MICROSERVICES_ONLY=false
SHOW_LEVELS=false
USE_JSON=false
USE_YAML=false
SHOW_STATS=false
FILTER_EXTENSIONS=""
EXCLUDE_EXTENSIONS=""
ONLY_CHANGED=false
SHORTEN_PATHS=false
SHORTEN_LEVEL=0
FLATTEN_SEPARATOR="."
FILE_NAME_PATTERN=""
SELECT_FILES_ONLY=false

# ── v5.0.0 additions ─────────────────────────────────────────────────
FOLLOW_SYMLINKS=false
DRY_RUN=false
SHOW_LINE_COUNT=false
WATCH_MODE=false
