  local TITLE="GOLURK"
  local SUB="Project Structure Analyzer v${VERSION}"
  if command -v figlet &>/dev/null && command -v lolcat &>/dev/null; then
    figlet -f "ANSI Shadow" "$TITLE" | lolcat --spread=10 --freq=0.13 || true
    echo "   $SUB" | lolcat || true
  else
    echo "=== $TITLE - $SUB ==="
  fi
  cat <<'EOF'
Usage:
  golurk                     Show this banner
  golurk tree [options]      Generate project tree (full feature set)
  golurk micro [options]     List microservices or select them
  golurk stats [options]     Show project statistics
  golurk diff [commit]       Show files changed vs commit/branch

Common examples:
  golurk tree --level 3 --shorten-paths
  golurk tree -m "auth,payment" -d "controller" --desktop -o mytree.txt
  golurk tree -f "pom.xml" -C contents.txt
  golurk tree --json -o structure.json
  golurk tree -C context.txt --template "Analyze this {LANG} project:"
  golurk tree --watch --watch-interval 5
  golurk micro
  golurk stats --desktop --line-count
  golurk diff main

Run `golurk tree --help` for all tree options.
EOF
}

