#!/usr/bin/env bash
# golurk - Full featured Project Structure Analyzer (WSL/Windows friendly)
# Version: 1.1.0
# Features:
#   - Extreme Performance (AWK serialization, xargs batching, zero-subprocess loops)
#   - High-performance context aggregation with Git ls-files fast-paths
#   - Project Tree Visualization (colorized, customizable depth/patterns)
#   - JSON & YAML Structure Export (Powered natively by AWK)
#   - LLM-optimized Markdown Code Blocks & Token Estimation
#   - Git Integration (diff analysis, --changed, fast pathing)
#   - Full .gitignore Support (including negation ! and double-star **)
#   - Advanced Filtering (by extension, size limit, binary skipping)
#   - Watch Mode (--watch) for live-reloading analysis
#   - Project-level Config (.golurkrc)
#   - Microservice Detection & Selection
#   - Cross-Platform Compatibility (WSL & Windows Desktop mapping)
set -euo pipefail
IFS=$'\n\t'

# Capture original args BEFORE any parsing (used by --watch re-exec)
ORIGINAL_ARGS=("$@")

# ──────────────────────────────────────────────────────────────────────
# Basic env & defaults
# ──────────────────────────────────────────────────────────────────────
